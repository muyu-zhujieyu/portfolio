[
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P001",
    "sentence_id": "DOC001_P001_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic Cylinder (Boom Cylinder, YG-250)",
    "text": "液压缸活塞密封件在长期使用中会因磨损、老化和油液污染导致密封失效，引发内泄漏。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P001",
    "sentence_id": "DOC001_P001_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic Cylinder (Boom Cylinder, YG-250)",
    "text": "密封失效导致的内泄漏会引起系统流量损失，进而造成工作压力下降，最终表现为油缸动作缓慢无力。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P002",
    "sentence_id": "DOC001_P002_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic Pump Inlet Filter (LF-100)",
    "text": "液压泵入口过滤器滤芯堵塞会导致吸油阻力增大，当入口真空度过高时，油液中溶解的空气析出，引发泵气蚀现象。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P002",
    "sentence_id": "DOC001_P002_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic Pump Inlet Filter (LF-100)",
    "text": "气蚀发生后，泵内会产生异常噪声和振动，同时泵的容积效率显著下降。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P003",
    "sentence_id": "DOC001_P003_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic System Cooling Circuit (HE-500)",
    "text": "冷却系统风扇故障或散热器堵塞将导致液压油温度持续升高，当油温超过70°C时，油液粘度急剧下降。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P003",
    "sentence_id": "DOC001_P003_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Hydraulic System Cooling Circuit (HE-500)",
    "text": "粘度下降会削弱油膜的承载能力，加剧各密封面的内泄漏，形成油温升高-泄漏增大-油位下降-冷却不足的恶性循环。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P004",
    "sentence_id": "DOC001_P004_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Bladder Accumulator (NXQ-40)",
    "text": "皮囊式蓄能器皮囊破裂后，蓄能器丧失压力保持能力，导致系统压力在负载变化时产生剧烈波动。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P004",
    "sentence_id": "DOC001_P004_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Bladder Accumulator (NXQ-40)",
    "text": "蓄能器压力保持失效还会导致泵频繁启停，加速泵的疲劳损坏。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P005",
    "sentence_id": "DOC001_P005_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Proportional Directional Valve (4WRA-10)",
    "text": "液压油液污染是比例阀故障的首要原因，污染物颗粒会磨损阀芯配合面或导致阀芯卡滞，破坏流量控制精度。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P005",
    "sentence_id": "DOC001_P005_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Proportional Directional Valve (4WRA-10)",
    "text": "流量控制异常会引发系统压力波动，影响所有执行元件的运动平稳性。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P006",
    "sentence_id": "DOC001_P006_S01",
    "doc_type": "maintenance_manual",
    "equipment": "Pilot-Operated Relief Valve (DBW-20)",
    "text": "先导式溢流阀弹簧疲劳或先导阀口磨损会导致溢流压力设定值漂移，系统压力无法维持在额定值。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC001",
    "paragraph_id": "DOC001_P006",
    "sentence_id": "DOC001_P006_S02",
    "doc_type": "maintenance_manual",
    "equipment": "Pilot-Operated Relief Valve (DBW-20)",
    "text": "系统压力异常直接导致液压缸和液压马达的负载能力下降，设备无法完成额定工况作业。",
    "source_date": "2024-03-01"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P001",
    "sentence_id": "DOC002_P001_S01",
    "doc_type": "fmea",
    "equipment": "Hydraulic Cylinder (Boom Cylinder, YG-250)",
    "text": "FMEA分析显示，油缸密封件失效的发生概率为B级（偶尔发生），严重度为8（动作失效），RPN=96，属高风险项。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P001",
    "sentence_id": "DOC002_P001_S02",
    "doc_type": "fmea",
    "equipment": "Hydraulic Cylinder (Boom Cylinder, YG-250)",
    "text": "建议每2000工作小时更换活塞密封组件，每次检修时检查活塞杆表面有无划伤。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P002",
    "sentence_id": "DOC002_P002_S01",
    "doc_type": "fmea",
    "equipment": "Hydraulic Pump Inlet Filter (LF-100)",
    "text": "FMEA评估过滤器堵塞的严重度为6（容积效率下降），检测难度为3（在线监测可行），RPN=54。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P003",
    "sentence_id": "DOC002_P003_S01",
    "doc_type": "fmea",
    "equipment": "Hydraulic System Cooling Circuit (HE-500)",
    "text": "冷却系统失效FMEA：冷却风扇故障发生概率C级，严重度7（系统过热停机），RPN=84，建议每500小时检查风扇运行状况。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P004",
    "sentence_id": "DOC002_P004_S01",
    "doc_type": "fmea",
    "equipment": "Bladder Accumulator (NXQ-40)",
    "text": "蓄能器皮囊FMEA：皮囊破裂概率B级，严重度7（压力冲击），RPN=84。推荐每年检测一次充气压力。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P005",
    "sentence_id": "DOC002_P005_S01",
    "doc_type": "fmea",
    "equipment": "Proportional Directional Valve (4WRA-10)",
    "text": "比例阀FMEA：油液污染导致阀芯卡滞的概率A级（频繁发生），严重度8（控制失效），RPN=128，属最高风险等级。",
    "source_date": "2024-04-10"
  },
  {
    "source_id": "DOC002",
    "paragraph_id": "DOC002_P006",
    "sentence_id": "DOC002_P006_S01",
    "doc_type": "fmea",
    "equipment": "Pilot-Operated Relief Valve (DBW-20)",
    "text": "溢流阀FMEA：弹簧疲劳发生概率C级，严重度7（系统压力异常），RPN=63。推荐每年校验溢流压力设定值。",
    "source_date": "2024-04-10"
  },
